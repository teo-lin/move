{
  "name": "app.move.kineto",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "generate:exercises": "node scripts/generate-exercises.mjs",
    "build:android:debug": "cd android && gradlew.bat assembleDebug",
    "install:android:debug": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "sync:csv": "node scripts/sync-back-exercises.mjs",
    "generate:icon": "python scripts/make-launcher-icon.py",
    "build:android:release": "cd android && gradlew.bat assembleRelease",
    "install:android:release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "generate:sounds": "python scripts/make-cue-sounds.py"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.86.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "15.15.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
